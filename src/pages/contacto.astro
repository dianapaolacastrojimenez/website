---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Diana Castro | Contacto y Estudio" description="Conecta con la artista visual Diana Paola Castro. Adquisición de obras, comisiones y diálogo sobre arte.">

<div class="contacto-editorial-wrapper">
  
  <!-- Panel Izquierdo: Exhibición de la Obra -->
  <aside class="panel-arte">
    <div class="exhibicion-obra">
      <img src="/horizontal1.jpg" alt="Composición artística en cianotipia por Diana Castro" loading="lazy" />
    </div>
  </aside>

  <!-- Panel Derecho: Interacción y Diálogo -->
  <main class="panel-formulario">
    <div class="contenido-derecho">
      
      <!-- Mensaje Trascendente -->
      <div class="mensaje-intro">
        <h2>El arte es un puente</h2>
        <p>Cada obra es el inicio de un diálogo sobre el tiempo, la luz y la memoria. Escríbeme para consultas sobre adquisiciones, exposiciones o colaboraciones.</p>
      </div>

      <!-- 1. Sección de Instagram -->
      <div class="instagram-invitation">
        <h3>Acompa&ntilde;a el proceso creativo</h3>
        <p>Explora vistazos exclusivos de mi estudio y sigue la evolución de mis series en tiempo real:</p>
        <a 
          href="https://www.instagram.com/artdcastro/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn-instagram"
        >
          Visitar @artdcastro
        </a>
      </div>

      <hr class="divisor" />

      <!-- 2. Formulario de Contacto -->
      <div class="formulario-wrapper">
        <h3>Iniciemos una conversaci&oacute;n</h3>
        <p class="form-descripcion">Completa los detalles a continuaci&oacute;n y me pondr&eacute; en contacto contigo a la brevedad posible.</p>

        <form action="https://formspree.io/f/mdaqwewd" method="POST" class="formulario-contacto" id="form-contacto">
          
          <div class="grupo-input">
            <label for="nombre">Nombre completo:</label>
            <input type="text" id="nombre" name="nombre" required placeholder="Ej. Emilio Andres" />
          </div>

          <div class="grupo-input">
            <label for="email">Tu correo electr&oacute;nico:</label>
            <input type="email" id="email" name="email" required placeholder="Ej. violeta@correo.com" />
          </div>

          <!-- Campo: Confirmación de correo -->
          <div class="grupo-input">
            <label for="email_confirmar">Confirma tu correo electr&oacute;nico:</label>
            <input type="email" id="email_confirmar" name="email_confirmar" required placeholder="Vuelve a escribir tu correo" autocomplete="off" />
            <span id="error-email" class="mensaje-error">Los correos no coinciden. Por favor, verifica.</span>
          </div>

          <!-- Campo: Teléfono (Opcional) -->
          <div class="grupo-input">
            <label for="telefono">Tel&eacute;fono de contacto (Opcional):</label>
            <input type="tel" id="telefono" name="telefono" placeholder="Ej. +57 300 000 0000" />
          </div>

          <div class="grupo-input">
            <label for="mensaje">Mensaje:</label>
            <textarea id="mensaje" name="mensaje" rows="5" required placeholder="Escribe tu mensaje aqu&iacute;..."></textarea>
          </div>

          <!-- Campo oculto para evitar spam -->
          <input type="text" name="_gotcha" style="display:none" />

          <button type="submit" class="btn-enviar">Enviar Mensaje</button>
        </form>
      </div>

    </div>
  </main>

</div>

</Layout>

<!-- Estilos nativos de Astro -->
<style>
  /* --- Diseño Editorial Optimizado --- */
  .contacto-editorial-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    font-family: system-ui, -apple-system, sans-serif;
    max-width: 1440px; /* Evita que se separen demasiado en pantallas Ultra-Wide */
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .contacto-editorial-wrapper {
      flex-direction: row;
    }
  }

  /* --- Panel de Arte --- */
  .panel-arte {
    width: 100%;
    background-color: #f7f7f7;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem; /* Menos espacio inútil en móviles */
  }

  @media (min-width: 900px) {
    .panel-arte {
      width: 45%;
      position: sticky;
      top: 0;
      height: 100vh;
      padding: 3rem;
    }
  }

  .exhibicion-obra {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .exhibicion-obra img {
    max-width: 100%;
    max-height: 45vh; /* En móvil, la imagen no empuja tanto el contenido hacia abajo */
    object-fit: contain;
    box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.2);
    background-color: #fff;
    transition: transform 0.5s ease;
  }

  @media (min-width: 900px) {
    .exhibicion-obra img {
      max-height: 85vh; /* Retoma su tamaño grande en escritorio */
    }
  }

  .exhibicion-obra img:hover {
    transform: scale(1.02);
  }

  /* --- Panel del Formulario --- */
  .panel-formulario {
    width: 100%;
    background-color: #ffffff;
    display: flex;
    justify-content: center; /* Centrado en móviles */
    padding: 3rem 1.5rem;
  }

  @media (min-width: 900px) {
    .panel-formulario {
      width: 55%;
      /* Alineamos hacia la izquierda (hacia la imagen) para cerrar el hueco */
      justify-content: flex-start; 
      padding: 4rem 4rem 4rem 3rem;
      overflow-y: auto;
    }
  }

  .contenido-derecho {
    width: 100%;
    max-width: 550px; /* Limita el ancho del texto para mejor lectura */
  }

  /* --- Mensaje Introductorio --- */
  .mensaje-intro {
    margin-bottom: 3rem;
  }

  .mensaje-intro h2 {
    font-family: 'Times New Roman', Times, serif;
    font-size: 2.2rem;
    margin-bottom: 1rem;
    font-weight: 400;
    color: #111;
  }

  .mensaje-intro p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #555;
  }

  @media (min-width: 900px) {
    .mensaje-intro h2 { font-size: 2.5rem; }
    .mensaje-intro p { font-size: 1.1rem; }
  }

  /* --- Estilos Instagram --- */
  .instagram-invitation {
    background-color: #fcfcfc;
    border: 1px solid #eaeaea;
    border-radius: 4px;
    padding: 2rem;
    text-align: center;
    margin-bottom: 1rem;
  }

  .instagram-invitation h3 {
    margin-top: 0;
    color: #111;
    font-family: 'Times New Roman', Times, serif;
    font-size: 1.6rem;
  }

  .instagram-invitation p {
    color: #666;
    line-height: 1.5;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .btn-instagram {
    display: inline-block;
    padding: 0.75rem 1.8rem;
    background-color: transparent;
    color: #E1306C;
    border: 1px solid #E1306C;
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.8rem;
  }

  .btn-instagram:hover {
    background-color: #E1306C;
    color: white;
  }

  .divisor {
    border: 0;
    height: 1px;
    background-color: #eaeaea;
    margin: 2.5rem 0;
  }

  /* --- Estilos Formulario --- */
  .formulario-wrapper h3 {
    margin-top: 0;
    color: #111;
    font-family: 'Times New Roman', Times, serif;
    font-size: 1.8rem;
  }

  .form-descripcion {
    color: #666;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .formulario-contacto {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .grupo-input {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .grupo-input label {
    font-weight: 500;
    color: #333;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .grupo-input input,
  .grupo-input textarea {
    padding: 0.9rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
    font-family: inherit;
    transition: all 0.3s ease;
    background-color: #fafafa;
  }

  .grupo-input input:focus,
  .grupo-input textarea:focus {
    outline: none;
    border-color: #111;
    background-color: #fff;
    box-shadow: 0 0 0 1px #111;
  }

  .mensaje-error {
    display: none;
    color: #E1306C;
    font-size: 0.85rem;
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .btn-enviar {
    padding: 1.2rem;
    background-color: #111;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 0.95rem;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-top: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .btn-enviar:hover {
    background-color: #333;
  }
</style>

<!-- Lógica de validación avanzada de correos -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('form-contacto');
    const email = document.getElementById('email');
    const emailConfirmar = document.getElementById('email_confirmar');
    const errorMensaje = document.getElementById('error-email');

    const validarCorreos = () => {
      const correo1 = email.value.trim().toLowerCase();
      const correo2 = emailConfirmar.value.trim().toLowerCase();

      if (correo1 !== correo2 && correo2 !== '') {
        errorMensaje.style.display = 'block';
        emailConfirmar.style.borderColor = '#E1306C';
        return false;
      } else {
        errorMensaje.style.display = 'none';
        emailConfirmar.style.borderColor = '#111';
        return true;
      }
    };

    if (form) {
      form.addEventListener('submit', (e) => {
        const correo1 = email.value.trim().toLowerCase();
        const correo2 = emailConfirmar.value.trim().toLowerCase();
        
        if (correo1 !== correo2) {
          e.preventDefault();
          errorMensaje.style.display = 'block';
          emailConfirmar.style.borderColor = '#E1306C';
          emailConfirmar.focus();
        }
      });

      emailConfirmar.addEventListener('input', validarCorreos);
      email.addEventListener('input', () => {
        if (emailConfirmar.value !== '') {
          validarCorreos();
        }
      });

      emailConfirmar.addEventListener('paste', (e) => {
        e.preventDefault();
        alert('Para mayor seguridad, por favor teclea tu correo manualmente.');
      });
    }
  });
</script>
