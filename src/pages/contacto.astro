---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Diana Castro | Artista Contemporánea" description="Explora la obra de Diana Paola Castro Jiménez. Especialista en cianotipia, memoria e identidad.">

<section class="contacto-contenedor">
  
  <!-- 1. Sección de Instagram -->
  <div class="instagram-invitation">
    <h3>Acompa&ntilde;a el proceso creativo</h3>
    <p>
      Si deseas conocer m&aacute;s sobre el d&iacute;a a d&iacute;a de la artista, explorar vistazos de su estudio y seguir de cerca su proceso creativo, te invitamos a ingresar a su espacio en Instagram:
    </p>
    <a 
      href="https://www.instagram.com/artdcastro/" 
      target="_blank" 
      rel="noopener noreferrer"
      class="btn-instagram"
    >
      Visitar @artdcastro en Instagram
    </a>
  </div>

  <hr class="divisor" />

  <!-- 2. Formulario de Contacto -->
  <div class="formulario-wrapper">
    <h3>Env&iacute;a un mensaje a Diana</h3>
    <p class="form-descripcion">Completa el siguiente formulario y Diana se pondr&aacute; en contacto contigo a la brevedad posible.</p>

    <form action="https://formspree.io/f/mdaqwewd" method="POST" class="formulario-contacto" id="form-contacto">
      
      <div class="grupo-input">
        <label for="nombre">Nombre completo:</label>
        <input type="text" id="nombre" name="nombre" required placeholder="Ej. Emilio Andres" />
      </div>

      <div class="grupo-input">
        <label for="email">Tu correo electr&oacute;nico:</label>
        <input type="email" id="email" name="email" required placeholder="Ej. violeta@correo.com" />
      </div>

      <!-- Campo: Confirmación de correo -->
      <div class="grupo-input">
        <label for="email_confirmar">Confirma tu correo electr&oacute;nico:</label>
        <input type="email" id="email_confirmar" name="email_confirmar" required placeholder="Vuelve a escribir tu correo" autocomplete="off" />
        <span id="error-email" class="mensaje-error">Los correos no coinciden. Por favor, verifica.</span>
      </div>

      <!-- Campo: Teléfono (Opcional) -->
      <div class="grupo-input">
        <label for="telefono">Tel&eacute;fono de contacto (Opcional):</label>
        <input type="tel" id="telefono" name="telefono" placeholder="Ej. +57 300 000 0000" />
      </div>

      <div class="grupo-input">
        <label for="mensaje">Mensaje:</label>
        <textarea id="mensaje" name="mensaje" rows="5" required placeholder="Escribe tu mensaje aqu&iacute;..."></textarea>
      </div>

      <!-- Campo oculto para evitar spam -->
      <input type="text" name="_gotcha" style="display:none" />

      <button type="submit" class="btn-enviar">Enviar Mensaje</button>
    </form>
  </div>

</section>

</Layout>

<!-- Estilos nativos de Astro -->
<style>
  .contacto-contenedor {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .instagram-invitation {
    background-color: #fafafa;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .instagram-invitation h3 {
    margin-top: 0;
    color: #333;
  }

  .instagram-invitation p {
    color: #555;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .btn-instagram {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: #E1306C;
    color: white;
    text-decoration: none;
    font-weight: 600;
    border-radius: 6px;
    transition: background-color 0.3s ease;
  }

  .btn-instagram:hover {
    background-color: #c1255b;
  }

  .divisor {
    border: 0;
    height: 1px;
    background-color: #eaeaea;
    margin: 3rem 0;
  }

  .formulario-wrapper h3 {
    margin-top: 0;
    color: #333;
  }

  .form-descripcion {
    color: #555;
    margin-bottom: 2rem;
  }

  .formulario-contacto {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .grupo-input {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .grupo-input label {
    font-weight: 600;
    color: #444;
    font-size: 0.9rem;
  }

  .grupo-input input,
  .grupo-input textarea {
    padding: 0.75rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.3s ease;
  }

  .grupo-input input:focus,
  .grupo-input textarea:focus {
    outline: none;
    border-color: #333;
  }

  .mensaje-error {
    display: none;
    color: #E1306C;
    font-size: 0.85rem;
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .btn-enviar {
    padding: 1rem;
    background-color: #111;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-top: 1rem;
  }

  .btn-enviar:hover {
    background-color: #333;
  }
</style>

<!-- Lógica de validación avanzada de correos -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('form-contacto');
    const email = document.getElementById('email');
    const emailConfirmar = document.getElementById('email_confirmar');
    const errorMensaje = document.getElementById('error-email');

    // Función que compara ambos campos
    const validarCorreos = () => {
      // Convertimos a minúsculas y quitamos espacios accidentales
      const correo1 = email.value.trim().toLowerCase();
      const correo2 = emailConfirmar.value.trim().toLowerCase();

      // Solo mostramos el error si el segundo campo no está vacío y no coinciden
      if (correo1 !== correo2 && correo2 !== '') {
        errorMensaje.style.display = 'block';
        emailConfirmar.style.borderColor = '#E1306C';
        return false;
      } else {
        errorMensaje.style.display = 'none';
        emailConfirmar.style.borderColor = '#ccc';
        return true;
      }
    };

    if (form) {
      // 1. Validar justo en el momento de hacer clic en "Enviar"
      form.addEventListener('submit', (e) => {
        const correo1 = email.value.trim().toLowerCase();
        const correo2 = emailConfirmar.value.trim().toLowerCase();
        
        if (correo1 !== correo2) {
          e.preventDefault(); // Bloquea el envío definitivo
          errorMensaje.style.display = 'block';
          emailConfirmar.style.borderColor = '#E1306C';
          emailConfirmar.focus(); // Lleva el cursor al error
        }
      });

      // 2. Validar en tiempo real mientras el usuario escribe
      emailConfirmar.addEventListener('input', validarCorreos);
      email.addEventListener('input', () => {
        if (emailConfirmar.value !== '') {
          validarCorreos();
        }
      });

      // 3. Bloquear la función de "Pegar" en el campo de confirmación
      emailConfirmar.addEventListener('paste', (e) => {
        e.preventDefault();
        alert('Para mayor seguridad, por favor teclea tu correo manualmente.');
      });
    }
  });
</script>
