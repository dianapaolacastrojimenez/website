---
import Layout from '../layouts/Layout.astro';
// Descomenta la siguiente línea si usas tu componente de navegación
// import Header from '../components/Header.astro';
---

<Layout title="Diana Castro | Inicio" description="Portafolio oficial de Diana Paola Castro Jiménez. Especialista en cianotipia, memoria e identidad.">

  <!-- <Header /> -->

  <main class="inicio-contenedor">
    
    <!-- Encabezado de la Galería -->
    <header class="hero-seccion">
      <h1>Obra Reciente</h1>
      <p>Una exploraci&oacute;n de la memoria, el tiempo y la luz a trav&eacute;s de la cianotipia.</p>
    </header>

    <hr class="divisor" />

    <!-- Galería Principal -->
    <section class="galeria-grid">
      
      <!-- Obra 1 (Puedes duplicar este bloque para agregar más obras) -->
      <article class="item-galeria trigger-lightbox">
        <div class="imagen-wrapper">
          <!-- Reemplaza con el nombre de tus archivos reales en /public/ -->
          <img src="/horizontal1.jpg" alt="Serie Tiempo al Tiempo - Composición 1" loading="lazy" />
          <div class="overlay-hover">
            <span>+ Ampliar</span>
          </div>
        </div>
      </article>

      <!-- Obra 2 -->
      <article class="item-galeria trigger-lightbox">
        <div class="imagen-wrapper">
          <img src="/artista2.JPG" alt="Autorretrato y exploración etérea" loading="lazy" />
          <div class="overlay-hover">
            <span>+ Ampliar</span>
          </div>
        </div>
      </article>

      <!-- Obra 3 (Ejemplo de relleno, reemplaza la ruta) -->
      <article class="item-galeria trigger-lightbox">
        <div class="imagen-wrapper">
          <img src="/artista1.JPG" alt="Diana Castro en el estudio" loading="lazy" />
          <div class="overlay-hover">
            <span>+ Ampliar</span>
          </div>
        </div>
      </article>

      <!-- Puedes seguir añadiendo más <article> aquí -->

    </section>

  </main>

  <!-- Modal Nativo Universal para la Galería -->
  <dialog id="modal-lightbox" class="lightbox-modal">
    <div class="lightbox-contenido">
      <button id="cerrar-modal" class="btn-cerrar-modal" aria-label="Cerrar obra">&times;</button>
      
      <!-- La imagen en blanco que se llenará dinámicamente con JS -->
      <img id="img-modal" src="" alt="" />
      
      <!-- Opcional: Un pie de foto elegante -->
      <p id="caption-modal" class="caption-modal"></p>
    </div>
  </dialog>

</Layout>

<!-- Estilos Nativos de Astro -->
<style>
  .inicio-contenedor {
    max-width: 1440px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    font-family: system-ui, -apple-system, sans-serif;
  }

  @media (min-width: 900px) {
    .inicio-contenedor {
      padding: 5rem 4rem;
    }
  }

  /* --- Hero / Encabezado --- */
  .hero-seccion {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem auto;
  }

  .hero-seccion h1 {
    font-family: 'Times New Roman', Times, serif;
    font-size: 2.8rem;
    color: #111;
    margin-bottom: 1rem;
    letter-spacing: 0.5px;
  }

  .hero-seccion p {
    font-size: 1.1rem;
    color: #666;
    line-height: 1.6;
  }

  .divisor {
    border: 0;
    height: 1px;
    background-color: #eaeaea;
    margin: 0 auto 4rem auto;
    max-width: 100px; /* Un divisor corto y elegante */
  }

  /* --- Grid de la Galería --- */
  .galeria-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
  }

  /* Diseño adaptable: 2 columnas en tablets, 3 en escritorio */
  @media (min-width: 600px) {
    .galeria-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .galeria-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .item-galeria {
    cursor: zoom-in;
    display: flex;
    flex-direction: column;
  }

  .imagen-wrapper {
    position: relative;
    overflow: hidden;
    background-color: #f7f7f7;
    border-radius: 2px;
    aspect-ratio: 3 / 4; /* Proporción estándar de arte para mantener uniformidad */
  }

  .imagen-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Asegura que la imagen llene el recuadro de forma elegante */
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.6s ease;
  }

  .overlay-hover {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(17, 17, 17, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .overlay-hover span {
    color: white;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.9rem;
    border: 1px solid white;
    padding: 0.8rem 1.5rem;
    transform: translateY(15px);
    transition: transform 0.4s ease;
  }

  /* Efectos Hover */
  .item-galeria:hover .imagen-wrapper img {
    transform: scale(1.05);
    filter: grayscale(20%); /* Dañado artístico leve al hacer hover */
  }

  .item-galeria:hover .overlay-hover {
    opacity: 1;
  }

  .item-galeria:hover .overlay-hover span {
    transform: translateY(0);
  }

  /* --- Estilos del Lightbox Nativo --- */
  .lightbox-modal {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
  }

  .lightbox-modal::backdrop {
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(5px);
  }

  .lightbox-contenido {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 2rem;
  }

  .lightbox-contenido img {
    max-width: 100%;
    max-height: 85vh; /* Deja espacio para el pie de foto */
    object-fit: contain;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }

  .caption-modal {
    color: #ccc;
    margin-top: 1.5rem;
    font-family: 'Times New Roman', Times, serif;
    font-size: 1.2rem;
    letter-spacing: 1px;
    text-align: center;
  }

  .btn-cerrar-modal {
    position: absolute;
    top: 20px;
    right: 30px;
    background: none;
    border: none;
    color: white;
    font-size: 3rem;
    cursor: pointer;
    line-height: 1;
    transition: color 0.3s ease;
    z-index: 10;
  }

  .btn-cerrar-modal:hover {
    color: #E1306C;
  }
</style>

<!-- Lógica dinámica del Lightbox para Galerías -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('modal-lightbox');
    const imgModal = document.getElementById('img-modal') as HTMLImageElement;
    const captionModal = document.getElementById('caption-modal');
    const btnCerrar = document.getElementById('cerrar-modal');
    
    // Seleccionamos TODAS las imágenes de la galería
    const itemsGaleria = document.querySelectorAll('.trigger-lightbox');

    if (modal && imgModal && btnCerrar) {
      
      // Asignar el evento a cada obra
      itemsGaleria.forEach(item => {
        item.addEventListener('click', () => {
          // Buscamos la imagen dentro del artículo clicado
          const imgElement = item.querySelector('img');
          
          if (imgElement) {
            // Transferimos los datos al modal
            imgModal.src = imgElement.src;
            imgModal.alt = imgElement.alt;
            
            // Usamos el 'alt' de la imagen como título/pie de foto
            if (captionModal) {
              captionModal.textContent = imgElement.alt;
            }

            // Mostramos el modal
            (modal as HTMLDialogElement).showModal();
            document.body.style.overflow = 'hidden'; // Bloquea el scroll de la página de fondo
          }
        });
      });

      // Lógica para cerrar el modal
      const cerrarModal = () => {
        (modal as HTMLDialogElement).close();
        document.body.style.overflow = '';
        
        // Limpiamos el src al cerrar por seguridad/rendimiento
        setTimeout(() => { imgModal.src = ''; }, 300);
      };

      btnCerrar.addEventListener('click', cerrarModal);

      // Cerrar al hacer clic fuera de la imagen (en el fondo negro)
      modal.addEventListener('click', (e) => {
        if (e.target === modal || (e.target as HTMLElement).classList.contains('lightbox-contenido')) {
          cerrarModal();
        }
      });
    }
  });
</script>
