---
import Layout from "../layouts/Layout.astro";
import SeriesGallery from "../components/SeriesGallery.astro";

import {
  fetchArtworks,
  fetchCarousel
} from "../lib/google";

import type {
  Artwork,
  CarouselImage
} from "../lib/google";


let artworks: Artwork[] = [];
let carouselImages: CarouselImage[] = [];


try {

  const result =
    await fetchArtworks();

  if (
    Array.isArray(result)
  ) {

    artworks = result;

  }


  const carouselResult =
    await fetchCarousel();

  if (
    Array.isArray(carouselResult)
  ) {

    carouselImages =
      carouselResult;

  }

} catch (error) {

  console.error(
    "Error al descargar los datos de Google Sheets:",
    error
  );

}


/*
 * Salvavidas del carrusel.
 *
 * Si Google Sheets falla o la pestaña
 * Carrusel está vacía, utilizamos
 * una imagen local.
 */
if (
  carouselImages.length === 0
) {

  carouselImages = [

    {

      imageUrl:
        "/cyanotype_homenaje_en_azul_2.jpg",

      altText:
        "Diana Castro, artista contemporánea internacional. Retrato y obras exclusivas en cianotipia.",

      altTextEn:
        "Diana Castro, international contemporary artist. Portrait and exclusive cyanotype artworks."

    }

  ];

}


/*
 * Las dos obras destacadas son
 * las primeras dos según la columna
 * "orden" de Google Sheets.
 */
const featuredArtworks =
  artworks.slice(0, 2);


/*
 * Esta función permite que el botón
 * funcione incluso si en Google Sheets
 * escribimos:
 *
 * SI
 * Sí
 * si
 * YES
 * true
 * 1
 * X
 */
function shouldShowSeriesButton(
  obra: Artwork
): boolean {

  if (!obra) {
    return false;
  }


  if (
    obra.showSeriesButton === true
  ) {

    return true;

  }


  if (
    obra.showSeriesButton === false
  ) {

    return false;

  }


  const value =
    String(
      obra.showSeriesButton || ""
    )
      .trim()
      .toLowerCase()
      .normalize("NFD")
      .replace(
        /[\u0300-\u036f]/g,
        ""
      );


  return (
    value === "si" ||
    value === "yes" ||
    value === "true" ||
    value === "1" ||
    value === "x"
  );

}
---


<Layout
  title="Diana Castro | Cianotipia"
  description="Diana Castro, fotógrafa y artista contemporánea especializada en cianotipia. Obras originales, series fotográficas y piezas exclusivas para colecciones privadas."
>


  <!-- ====================================================== -->
  <!-- HERO / CARRUSEL -->
  <!-- ====================================================== -->

  <section
    class="relative min-h-[85vh] flex items-center justify-center overflow-hidden"
  >

    <!-- Carrusel de fondo -->

    <div
      id="hero-carousel"
      class="absolute inset-0 w-full h-full -z-20 bg-gray-50"
    >

      {
        carouselImages.map(
          (
            img,
            index
          ) => (

            <img
              src={img.imageUrl}
              alt={img.altText}
              class={`carousel-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-[2000ms] ease-in-out ${
                index === 0
                  ? "opacity-100"
                  : "opacity-0"
              }`}
              fetchpriority={
                index === 0
                  ? "high"
                  : "auto"
              }
              loading={
                index === 0
                  ? "eager"
                  : "lazy"
              }
            />

          )
        )
      }

    </div>


    <!-- Capa de contraste -->

    <div
      class="absolute inset-0 bg-white/60 backdrop-blur-[4px] -z-10"
    >
    </div>


    <!-- Contenido principal -->

    <div
      class="max-w-4xl mx-auto px-6 text-center z-10 mb-10 md:mb-16"
    >

      <h1
        class="font-serif text-5xl md:text-7xl lg:text-[5rem] text-deep-blue mb-6 leading-[1.1] tracking-tight drop-shadow-sm"
      >
        Materializando el tiempo a través de la luz
      </h1>


      <p
        class="font-sans text-lg md:text-xl text-gray-800 font-medium max-w-2xl mx-auto leading-relaxed drop-shadow-sm"
      >
        Cianotipias e intervenciones conceptuales que desafían la inmediatez de la modernidad líquida. Obras de alta exclusividad donde la memoria se imprime en azul de Prusia.
      </p>

    </div>

  </section>


  <!-- ====================================================== -->
  <!-- OBRAS DESTACADAS -->
  <!-- ====================================================== -->

  <section
    id="obras-destacadas"
    class="py-24 md:py-32"
  >

    <div
      class="max-w-7xl mx-auto px-6"
    >

      <!-- Encabezado -->

      <div
        class="max-w-3xl mb-16"
      >

        <p
          class="font-sans text-xs uppercase tracking-[0.25em] text-gray-500 mb-4"
        >
          Obras destacadas
        </p>


        <h2
          class="font-serif text-4xl md:text-5xl lg:text-6xl text-deep-blue leading-tight"
        >
          Una selección de obra
        </h2>

      </div>


      <!-- Obras -->

      {
        featuredArtworks.length === 0 ? (

          <p
            class="text-center text-warm-gray py-10"
          >
            Las obras se están cargando o no se pudieron conectar con la base de datos.
          </p>

        ) : (

          <div
            class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-20"
          >

            {
              featuredArtworks.map(
                (obra) => (

                  <article
                    class="group"
                    data-artwork-id={obra.id}
                  >

                    <!-- Imagen -->

                    <div
                      class="aspect-[4/5] bg-pale-rose overflow-hidden mb-6 relative shadow-sm"
                    >

                      <img
                        src={obra.imageUrl}
                        alt={`${obra.title} — Diana Castro`}
                        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                        loading="lazy"
                      />


                      <!-- Indicador visual -->

                      <div
                        class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300 z-10 flex items-center justify-center pointer-events-none"
                      >

                        <span
                          class="text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-3xl drop-shadow-md"
                        >
                          +
                        </span>

                      </div>

                    </div>


                    <!-- Información -->

                    <h3
                      class="font-serif text-2xl md:text-3xl text-deep-blue"
                    >
                      {obra.title}
                    </h3>


                    <p
                      class="font-sans text-sm mt-2 text-gray-600"
                    >
                      {obra.technique} — {obra.year}
                    </p>


                    <!-- ================================================= -->
                    <!-- BOTÓN DE SERIE -->
                    <!-- ================================================= -->

                    {
                      shouldShowSeriesButton(
                        obra
                      ) &&
                      obra.series && (

                        <button
                          type="button"
                          class="js-series-trigger mt-6 inline-flex items-center gap-3 border border-deep-blue bg-deep-blue px-6 py-3 text-white font-sans text-xs uppercase tracking-[0.18em] hover:bg-white hover:text-deep-blue transition-colors duration-300 cursor-pointer"
                          data-series={obra.series}
                          aria-label={`Ver todas las Cianotipias de la serie ${obra.series}`}
                        >

                          <span>
                            Ver todas las Cianotipias de esta serie
                          </span>


                          <span
                            aria-hidden="true"
                            class="text-base"
                          >
                            →
                          </span>

                        </button>

                      )
                    }


                  </article>

                )
              )
            }

          </div>

        )
      }

    </div>

  </section>


  <!-- ====================================================== -->
  <!-- GALERÍA DE LA SERIE -->
  <!-- ====================================================== -->

  <SeriesGallery
    artworks={artworks}
  />


  <!-- ====================================================== -->
  <!-- EL PROCESO -->
  <!-- ====================================================== -->

  <section
    id="proceso"
    class="py-24 md:py-32"
  >

    <div
      class="max-w-4xl mx-auto px-6 text-center"
    >

      <p
        class="font-sans text-xs uppercase tracking-[0.3em] text-deep-blue mb-4"
      >
        El proceso
      </p>


      <h2
        class="font-serif text-4xl md:text-5xl lg:text-6xl text-deep-blue mb-12"
      >
        La materialización del tiempo
      </h2>


      <div
        class="font-sans text-gray-700 leading-relaxed space-y-6 mb-12 text-left md:text-center"
      >

        <p>
          Esta es una ventana abierta al santuario creativo de Diana Castro, donde la luz solar, el rigor del tiempo y la emulsión química convergen en un acto de pura alquimia visual. Cada pieza fotográfica nace de un diálogo íntimo con el papel de algodón. Las texturas orgánicas, las siluetas melancólicas y la profunda inmersión en el azul de Prusia garantizan la imposibilidad de la réplica. En una era de sobreproducción digital masiva, esta técnica analógica se erige como un acto de rebeldía estética: la materialización de lo efímero.
        </p>


        <p>
          Adquirir una de estas obras es asegurar un fragmento tangible del tiempo. Un testimonio irrefutable de maestría técnica destinado a elevar el prestigio de cualquier colección privada, galería o bóveda museográfica.
        </p>

      </div>


      <!-- Caja de valor -->

      <div
        class="bg-gray-50 border border-gray-200 p-8 mb-12 shadow-sm text-left md:text-center"
      >

        <h3
          class="font-serif text-xl text-deep-blue mb-3"
        >
          Exclusividad y Autenticidad
        </h3>


        <p
          class="font-sans text-sm text-gray-600 leading-relaxed"
        >
          Todas las piezas son
          <strong>
            obras originales y exclusivas
          </strong>,
          entregadas invariablemente con su respectivo
          <strong>
            certificado de originalidad
          </strong>.
          La artista también realiza
          <strong>
            obras por encargo
          </strong>
          y desarrolla
          <strong>
            colaboraciones
          </strong>
          para proyectos museográficos y curatoriales de alto nivel.
        </p>

      </div>


      <!-- Botones -->

      <div
        class="flex flex-col sm:flex-row justify-center items-center gap-6"
      >

        <a
          href="/contacto"
          class="w-full sm:w-auto px-10 py-4 bg-deep-blue border border-deep-blue text-white font-sans text-xs uppercase tracking-[0.2em] hover:bg-white hover:text-deep-blue transition-colors duration-300 text-center"
        >
          Adquirir Obra / Contacto
        </a>


        <a
          href="https://instagram.com/artdcastro"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-10 py-4 border border-deep-blue text-deep-blue font-sans text-xs uppercase tracking-[0.2em] hover:bg-deep-blue hover:text-white transition-colors duration-300 text-center"
        >
          Seguir en Instagram
        </a>

      </div>

    </div>

  </section>


</Layout>


<!-- ======================================================== -->
<!-- SCRIPT DEL CARRUSEL PRINCIPAL -->
<!-- ======================================================== -->

<script>
  const carouselSlides =
    document.querySelectorAll(
      ".carousel-slide"
    );


  if (
    carouselSlides.length > 1
  ) {

    let currentSlide = 0;


    setInterval(
      () => {

        carouselSlides[
          currentSlide
        ].classList.remove(
          "opacity-100"
        );

        carouselSlides[
          currentSlide
        ].classList.add(
          "opacity-0"
        );


        currentSlide =
          (
            currentSlide + 1
          ) %
          carouselSlides.length;


        carouselSlides[
          currentSlide
        ].classList.remove(
          "opacity-0"
        );

        carouselSlides[
          currentSlide
        ].classList.add(
          "opacity-100"
        );

      },
      7000
    );

  }
</script>
